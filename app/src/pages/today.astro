---
import '../styles/app.css';
import MoodInit from '../components/MoodInit.astro';
import { TodayCheckIn } from '../components/TodayCheckIn';
---

<html lang="en" data-theme="light" data-mood="clear">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Serein — Today's Weather</title>
    <style>
      body {
        background-color: var(--color-canvas);
        color: var(--color-primary);
        font-family: var(--font-body);
      }
    </style>
    <MoodInit />
  </head>
  <body>
    <!-- Top Nav (placeholder) -->
    <header class="p-4 border-b border-subtle flex justify-between items-center bg-surface">
      <a href="/demo" class="font-display font-medium text-lg">Serein</a>
      <a href="/demo" class="text-sm font-medium text-secondary hover:text-primary transition-colors">Demo</a>
    </header>

    <main class="min-h-dvh flex flex-col relative overflow-hidden">
      <!-- Background elements for mood transition -->
      <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-[20%] -left-[10%] w-[70%] h-[70%] rounded-full blur-[100px] opacity-20" style="background-color: var(--mood-a);"></div>
        <div class="absolute top-[40%] -right-[10%] w-[60%] h-[60%] rounded-full blur-[120px] opacity-15" style="background-color: var(--mood-b);"></div>
      </div>

      <TodayCheckIn client:load />
    </main>

  </body>
</html>
